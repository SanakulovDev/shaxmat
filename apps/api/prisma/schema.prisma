generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  email        String?   @unique
  passwordHash String?
  telegramId   BigInt?   @unique
  name         String
  avatarUrl    String?
  isGuest      Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
}

// One row per refresh token. Only a SHA-256 hash of the token secret is stored.
model Session {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretHash String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId])
}
