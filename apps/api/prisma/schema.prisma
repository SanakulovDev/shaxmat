generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String           @id @default(uuid(7)) @db.Uuid
  email        String?          @unique
  passwordHash String?
  telegramId   BigInt?          @unique
  name         String
  avatarUrl    String?
  isGuest      Boolean          @default(false)
  // Refreshed while the user has an open socket; see RealtimeService.
  lastSeenAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  sessions     Session[]
  ratings      Rating[]
  puzzleTries  PuzzleAttempt[]
  lessons      LessonProgress[]
  whiteGames   Game[]           @relation("WhiteGames")
  blackGames   Game[]           @relation("BlackGames")
  challenges   Challenge[]      @relation("ChallengeCreator")
  invitations  Challenge[]      @relation("ChallengeDest")
  friendsAsked Friendship[]     @relation("FriendRequester")
  friendsOf    Friendship[]     @relation("FriendAddressee")
  chatMessages ChatMessage[]
}

// One row per refresh token. Only a SHA-256 hash of the token secret is stored.
model Session {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretHash String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId])
}

enum RatingCategory {
  puzzle
  bullet
  blitz
  rapid
  classical
}

// Glicko-2 rating per category.
model Rating {
  userId     String         @db.Uuid
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   RatingCategory
  rating     Float
  rd         Float
  volatility Float
  count      Int            @default(0)
  updatedAt  DateTime       @updatedAt

  @@id([userId, category])
}

enum GameStatus {
  active
  finished
  aborted
}

// A bot game is saved once it is finished: `botLevel` is set and the bot's
// side has no user id. A game between people is created when a challenge is
// accepted and is updated after every move until it ends.
model Game {
  id              String          @id @default(uuid(7)) @db.Uuid
  whiteId         String?         @db.Uuid
  white           User?           @relation("WhiteGames", fields: [whiteId], references: [id], onDelete: SetNull)
  blackId         String?         @db.Uuid
  black           User?           @relation("BlackGames", fields: [blackId], references: [id], onDelete: SetNull)
  botLevel        Int?
  status          GameStatus      @default(finished)
  // PGN result: "1-0", "0-1" or "1/2-1/2"; "*" while the game goes on or
  // after an abort.
  result          String
  // Null while the game goes on.
  termination     String?
  pgn             String
  // Games between people only.
  rated           Boolean         @default(false)
  category        RatingCategory?
  // Seconds.
  timeInitial     Int?
  timeIncrement   Int?
  // UCI moves from the start position.
  moves           String[]        @default([])
  // Milliseconds left for each side as of `turnStartedAt`.
  whiteMs         Int?
  blackMs         Int?
  turnStartedAt   DateTime?
  // Side with an open offer: "w" or "b".
  drawOffer       String?
  takebackOffer   String?
  // Rounded Glicko-2 ratings before a rated game, and the change after it.
  whiteRating     Int?
  blackRating     Int?
  whiteRatingDiff Int?
  blackRatingDiff Int?
  // Bumped on every update; writes check it so two updates cannot interleave.
  revision        Int             @default(0)
  challenge       Challenge?
  createdAt       DateTime        @default(now())
  endedAt         DateTime?
  chatMessages    ChatMessage[]

  @@index([whiteId, createdAt])
  @@index([blackId, createdAt])
  @@index([status])
}

enum ChallengeColor {
  white
  black
  random
}

enum ChallengeStatus {
  open
  accepted
  declined
  cancelled
}

// An invitation to a game. Without `destId` anyone with the link can accept
// it; with `destId` only that user can.
model Challenge {
  id            String          @id @default(uuid(7)) @db.Uuid
  // Short code in the invite link.
  code          String          @unique
  creatorId     String          @db.Uuid
  creator       User            @relation("ChallengeCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  destId        String?         @db.Uuid
  dest          User?           @relation("ChallengeDest", fields: [destId], references: [id], onDelete: Cascade)
  // Creator's colour.
  color         ChallengeColor
  rated         Boolean
  // Seconds.
  timeInitial   Int
  timeIncrement Int
  status        ChallengeStatus @default(open)
  gameId        String?         @unique @db.Uuid
  game          Game?           @relation(fields: [gameId], references: [id], onDelete: SetNull)
  expiresAt     DateTime
  createdAt     DateTime        @default(now())

  @@index([creatorId, status])
  @@index([destId, status])
}

enum FriendshipStatus {
  pending
  accepted
}

// One row per pair of users: the requester asked the addressee.
model Friendship {
  requesterId String           @db.Uuid
  requester   User             @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String           @db.Uuid
  addressee   User             @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(pending)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@id([requesterId, addresseeId])
  @@index([addresseeId, status])
}

// Imported from the Lichess puzzle database (CC0).
model Puzzle {
  id              String          @id
  // Position before the opponent's first move.
  fen             String
  // UCI moves. moves[0] is the opponent's move; the solver plays moves[1],
  // moves[3], and so on.
  moves           String[]
  rating          Int
  ratingDeviation Int
  popularity      Int
  plays           Int
  themes          String[]
  attempts        PuzzleAttempt[]

  @@index([rating])
  @@index([themes], type: Gin)
}

// Only the first try at a puzzle changes the rating.
model PuzzleAttempt {
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  puzzleId     String
  puzzle       Puzzle   @relation(fields: [puzzleId], references: [id], onDelete: Cascade)
  solved       Boolean
  ratingBefore Float
  ratingAfter  Float
  createdAt    DateTime @default(now())

  @@id([userId, puzzleId])
}

model LessonProgress {
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonSlug  String
  completedAt DateTime @default(now())

  @@id([userId, lessonSlug])
}

// Chat between two friends in their game.
model ChatMessage {
  id        String   @id @default(uuid(7)) @db.Uuid
  gameId    String   @db.Uuid
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([gameId, createdAt])
}

// Used by the Socket.IO Postgres adapter for payloads over the NOTIFY size
// limit. The adapter reads and cleans it up; the app never touches it.
model SocketIoAttachment {
  id        BigInt    @id @default(autoincrement())
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz
  payload   Bytes?

  @@map("socket_io_attachments")
}
