# API (apps/api reads this file as ../../.env)
PORT=3100
DATABASE_URL=postgresql://shaxmat:shaxmat@localhost:5442/shaxmat
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
# Telegram login: bot token from @BotFather. Leave empty to disable.
TELEGRAM_BOT_TOKEN=

# Web (Vite reads only VITE_* variables from this file)
# Bot username without "@". Leave empty to hide the Telegram button.
VITE_TELEGRAM_BOT_USERNAME=

# Lesson narration (pnpm content:audio). Azure Speech has Uzbek voices;
# the free F0 tier covers the current lessons many times over.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional voice per language; defaults: uz-UZ-MadinaNeural, ru-RU-SvetlanaNeural, en-US-JennyNeural.
AZURE_SPEECH_VOICE_UZ=
AZURE_SPEECH_VOICE_RU=
AZURE_SPEECH_VOICE_EN=
